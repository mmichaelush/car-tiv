{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /* Build scripts and the Vite/Vitest config run under Node.
       Tests live in their own project (tsconfig.test.json) because they pull in
       Worker source, which needs the Cloudflare runtime library instead. */
    "lib": ["ES2023"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["scripts/**/*.ts", "shared/**/*.ts", "*.config.ts"]
}
