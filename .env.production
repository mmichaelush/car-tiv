# Build-time configuration for the production bundle.
#
# Only VITE_-prefixed variables reach the browser, and everything here is
# public by definition (it ends up in the shipped JavaScript). Secrets belong
# in Cloudflare Secrets — never in this file, and never in the repository.

# Google Tag Manager container. Empty disables analytics entirely.
VITE_GTM_ID=GTM-WD3C97FW
